# --- app ---
APP_NAME=Catronaut
APP_ENV=dev

# --- model serving (Ollama) ---
OLLAMA_BASE_URL=http://localhost:11434

# Which backend serves MODEL_NAME: ollama (dev) | openai_compat (prod).
# qwen3.8-27b is served by vLLM / SGLang over an OpenAI-compatible API and is not an
# Ollama model at all - see ROADMAP M1.6 and docs/qwen3.8-27b-reference.md.
MODEL_BACKEND=ollama

# Used only when MODEL_BACKEND=openai_compat. Point at the serving engine root;
# the provider appends /v1/chat/completions.
# OPENAI_BASE_URL=http://localhost:8000
# OPENAI_API_KEY=
# xhigh (the model's own default) | medium | low. Leave unset to let the server decide -
# the card warns that lowering it in multi-turn agentic work can RAISE total latency.
# OPENAI_REASONING_EFFORT=

# dev: qwen3:4b  |  prod: qwen3.8-27b
# The prod tag is not in the public Ollama library - it needs a Modelfile /
# private registry on the GPU server.
MODEL_NAME=qwen3:4b

# OPTIONAL. Unset = use the model's full window from app/core/model_profile.py
# (qwen3:4b -> 32768, qwen3.8-27b -> 262144). Set this ONLY to constrain a run below
# the model's real capability, e.g. a local CPU box short on RAM. Do not use it to
# describe the model - that is the profile's job, and a value here silently caps every
# model behind it.
# MODEL_NUM_CTX=4096

# Local CPU inference is slow; keep this generous.
MODEL_TIMEOUT_S=600

# Qwen3 hybrid reasoning. qwen3:4b currently ignores this and still emits
# reasoning inline; the provider strips the leaked block.
MODEL_THINK=false

# --- not in use yet (ROADMAP M4.4 session store) ---
# Postgres comes later on the GPU server; a Neon URL is the likely first form.
# DATABASE_URL=
# REDIS_URL=
